#!/bin/sh

usage() {
    cat <<'EOF'
Usage: create_truststore <file.pem>

Creates a PKCS12 truststore, truststore.pfx, in the current folder from
the certificates of a PEM file. Keys are left out. openssl asks for the
export password.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        echo "Unknown option '$1', see 'create_truststore --help'" >&2
        exit 1
        ;;
esac

if [ $# -lt 1 ]; then
    echo "Expected a PEM file, see 'create_truststore --help'" >&2
    exit 1
fi

lib=$(dirname "$0")/lib
"$lib/require_command" openssl || exit 1
"$lib/require_file" "$1" || exit 1

openssl pkcs12 -export -nokeys -in "$1" -out truststore.pfx
