#!/bin/sh

usage() {
    cat <<'EOF'
Usage: create_truststore <file.pem>

Creates a PKCS12 truststore, truststore.pfx, in the current folder from
the certificates of a PEM file. Keys are left out. openssl asks for the
export password.
EOF
}

if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    exit 0
fi

openssl pkcs12 -export -nokeys -in "$1" -out truststore.pfx
