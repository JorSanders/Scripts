#!/bin/sh

set -e

usage() {
    cat <<'EOF'
Usage: gacp <message>

Stages every change in the repository, commits them with <message> as the
commit message and pushes the commit.
EOF
}

if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    exit 0
fi

git add .
git commit -m "$1"
git push
