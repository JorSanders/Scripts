#!/bin/sh

set -e

usage() {
    cat <<'EOF'
Usage: gacp <message>

Stages every change in the repository, commits them with <message> as the
commit message and pushes the commit.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
esac

if [ $# -lt 1 ]; then
    echo "Expected a commit message, see 'gacp --help'" >&2
    exit 1
fi

git add .
git commit -m "$1"
git push
