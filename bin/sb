#!/bin/sh

usage() {
    cat <<'EOF'
Usage: sb [--pull]

Starts the spring boot application in the current folder with
'mvn spring-boot:run', with the tests skipped.

Runs mci first when the pom.xml changed since the last build, so the
dependencies in your local maven repository stay up to date.

    --pull  git pull before starting
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
esac

for arg in "$@"; do
    case "$arg" in
        --pull)
            echo 'Pulling'
            git pull
            ;;
    esac
done

if "$(dirname "$0")/lib/checksum_changed" pom.xml; then
    echo 'pom.xml changed; Running "mvn install -Dmaven.test.skip=true"'
    "$(dirname "$0")/mci"
fi

if java_home=$("$(dirname "$0")/lib/java_home_for_pom" pom.xml); then
    echo "Using the java in $java_home"
    JAVA_HOME=$java_home
    export JAVA_HOME
else
    echo "Using the default java"
fi

mvn clean spring-boot:run -Dmaven.test.skip=true
