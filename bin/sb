#!/bin/sh

usage() {
    cat <<'EOF'
Usage: sb [--pull]

Starts the spring boot application in the current folder with
'mvn spring-boot:run', with the tests skipped.

Runs mci first when the pom.xml changed since the last build, so the
dependencies in your local maven repository stay up to date.

    --pull  git pull before starting
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
esac

bin=$(dirname "$0")
lib=$bin/lib

"$lib/require_command" mvn || exit 1
"$lib/require_file" pom.xml || exit 1

pull=no

for arg in "$@"; do
    case "$arg" in
        --pull) pull=yes ;;
        *)
            echo "Unknown option '$arg', see 'sb --help'" >&2
            exit 1
            ;;
    esac
done

if [ "$pull" = yes ]; then
    echo 'Pulling'
    git pull
fi

"$lib/checksum_changed" pom.xml
case $? in
    0)
        echo 'pom.xml changed; Running "mvn install -Dmaven.test.skip=true"'
        "$bin/mci" || exit 1
        ;;
    1) ;;
    *) exit 1 ;;
esac

if java_home=$("$lib/java_home_for_pom" pom.xml); then
    echo "Using the java in $java_home"
    JAVA_HOME=$java_home
    export JAVA_HOME
else
    echo "Using the default java"
fi

mvn clean spring-boot:run -Dmaven.test.skip=true
