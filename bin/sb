#!/bin/sh

if [ "$1" = "--help" ]; then
    echo "Start a spring boot server"
    echo "Does a maven clean install if the pom.xml changed"
    echo " --pull to git pull before starting"
    exit 0
fi

for arg in "$@"; do
    case "$arg" in
        --pull)
            echo 'Pulling'
            git pull
            ;;
    esac
done

if "$(dirname "$0")/lib/checksum_changed" pom.xml; then
    echo 'pom.xml changed; Running "mvn install -Dmaven.test.skip=true"'
    "$(dirname "$0")/mci"
fi

JAVA_VERSION=$(sed -n 's|.*<java\.version>[[:space:]]*\([0-9][0-9.]*\).*|\1|p' pom.xml | head -n 1)
if [ -n "$JAVA_VERSION" ] && [ -x /usr/libexec/java_home ]; then
    echo "Detected java version: $JAVA_VERSION"
    JAVA_HOME=$(/usr/libexec/java_home -v "$JAVA_VERSION")
    export JAVA_HOME
else
    echo "Could not detect the java version from pom.xml, using the default java"
fi
mvn clean spring-boot:run -Dmaven.test.skip=true
