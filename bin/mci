#!/bin/sh

usage() {
    cat <<'EOF'
Usage: mci

Runs a maven clean install in the current folder, with the tests and the
dependency check skipped, and stores the pom.xml checksum afterwards so
sb knows the build is up to date.

JAVA_HOME is set to the java version named in the pom.xml, when that
version is installed. The checksum is only stored when the build
succeeds.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
esac

if java_home=$("$(dirname "$0")/lib/java_home_for_pom" pom.xml); then
    echo "Using the java in $java_home"
    JAVA_HOME=$java_home
    export JAVA_HOME
else
    echo "Using the default java"
fi

mvn clean install -Dmaven.test.skip=true -Ddependency-check.skip=true || exit 1

"$(dirname "$0")/lib/save_checksum" pom.xml
