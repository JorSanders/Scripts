#!/bin/sh

usage() {
    cat <<'EOF'
Usage: checksum <file>

Prints the sha256 checksum of <file>.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        echo "Unknown option '$1', see 'checksum --help'" >&2
        exit 1
        ;;
esac

if [ $# -lt 1 ]; then
    echo "Expected a file, see 'checksum --help'" >&2
    exit 1
fi

shasum -a 256 "$1" | cut -d' ' -f1
