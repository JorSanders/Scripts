#!/bin/sh

if [ $# -lt 1 ] || [ "$1" = "--help" ]; then
    echo "Check if the checksum of a file changed since it was last saved"
    echo "with save_checksum. Exits 0 when it changed, 1 when it did not."
    echo "\$1 is the file name"
    exit 0
fi

current=$("$(dirname "$0")/cof" "$1")
cached=$(cat ".globalignored/$1.checksum" 2>/dev/null)

[ "$current" != "$cached" ]
