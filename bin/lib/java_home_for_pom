#!/bin/sh

usage() {
    cat <<'EOF'
Usage: java_home_for_pom <pom.xml>

Prints the JAVA_HOME belonging to the java version named in the
<java.version> property of <pom.xml>, for the caller to export before
running maven.

Exits 1 with the reason on stderr when there is no such JAVA_HOME to
point at, so the caller can fall back to the default java.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        echo "Unknown option '$1', see 'java_home_for_pom --help'" >&2
        exit 1
        ;;
esac

if [ $# -lt 1 ]; then
    echo "Expected a pom.xml, see 'java_home_for_pom --help'" >&2
    exit 1
fi

pom=$1

if [ ! -f "$pom" ]; then
    echo "No such file: $pom" >&2
    exit 1
fi

java_version=$(sed -n 's|.*<java\.version>[[:space:]]*\([0-9][0-9.]*\).*|\1|p' "$pom" | head -n 1)

if [ -z "$java_version" ]; then
    echo "No <java.version> found in $pom" >&2
    exit 1
fi

if [ ! -x /usr/libexec/java_home ]; then
    echo "No /usr/libexec/java_home to look up java $java_version with" >&2
    exit 1
fi

if ! java_home=$(/usr/libexec/java_home -v "$java_version" 2>/dev/null); then
    echo "Java $java_version, required by $pom, is not installed" >&2
    exit 1
fi

printf '%s\n' "$java_home"
