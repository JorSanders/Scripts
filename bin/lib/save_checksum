#!/bin/sh

usage() {
    cat <<'EOF'
Usage: save_checksum <file>

Stores the sha256 checksum of <file> under .globalignored in the current
folder, for checksum_changed to compare against later. Useful for
detecting pom.xml and Gemfile.lock changes.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        echo "Unknown option '$1', see 'save_checksum --help'" >&2
        exit 1
        ;;
esac

if [ $# -lt 1 ]; then
    echo "Expected a file, see 'save_checksum --help'" >&2
    exit 1
fi

checksum_file=".globalignored/$1.checksum"

# Computed before the file is opened, so a failed checksum leaves any
# earlier one in place instead of truncating it to nothing.
if ! file_checksum=$("$(dirname "$0")/checksum" "$1"); then
    exit 1
fi

mkdir -p "$(dirname "$checksum_file")" || exit 1
printf '%s\n' "$file_checksum" >"$checksum_file"
