#!/bin/sh

if [ $# -lt 1 ] || [ "$1" = "--help" ]; then
    echo "Save the checksum of a file under .globalignored."
    echo "Useful for detecting Gemfile.lock and pom.xml changes."
    echo "\$1 is the file name"
    exit 0
fi

mkdir -p .globalignored
"$(dirname "$0")/cof" "$1" >".globalignored/$1.checksum"
