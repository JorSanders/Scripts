#!/bin/sh

usage() {
    cat <<'EOF'
Usage: save_checksum <file>

Stores the sha256 checksum of <file> under .globalignored in the current
folder, for checksum_changed to compare against later. Useful for
detecting pom.xml and Gemfile.lock changes.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
esac

if [ $# -lt 1 ]; then
    echo "Expected a file, see 'save_checksum --help'" >&2
    exit 1
fi

mkdir -p .globalignored
"$(dirname "$0")/cof" "$1" >".globalignored/$1.checksum"
