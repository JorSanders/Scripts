#!/bin/sh

usage() {
    cat <<'EOF'
Usage: create_certificate_fingerprint <cert.pem>

Prints the SHA1 fingerprint of a PEM encoded certificate.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        echo "Unknown option '$1', see 'create_certificate_fingerprint --help'" >&2
        exit 1
        ;;
esac

if [ $# -lt 1 ]; then
    echo "Expected a certificate, see 'create_certificate_fingerprint --help'" >&2
    exit 1
fi

lib=$(dirname "$0")/lib
"$lib/require_command" openssl || exit 1
"$lib/require_file" "$1" || exit 1

openssl x509 -noout -fingerprint -sha1 -inform pem -in "$1"
