#!/bin/sh

usage() {
    cat <<'EOF'
Usage: create_certificate_fingerprint <cert.pem>

Prints the SHA1 fingerprint of a PEM encoded certificate.
EOF
}

if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    exit 0
fi

openssl x509 -noout -fingerprint -sha1 -inform pem -in "$1"
