#!/bin/sh

usage() {
    cat <<'EOF'
Usage: create_certkey <common-name>

Creates a self signed RSA 4096 certificate and its key in the current
folder, as cert.pem and key.pem. <common-name> becomes the CN of the
certificate and localhost is added as a subject alternative name.

The certificate is valid for 9000 days.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        echo "Unknown option '$1', see 'create_certkey --help'" >&2
        exit 1
        ;;
esac

if [ $# -lt 1 ]; then
    echo "Expected a common name for the certificate, see 'create_certkey --help'" >&2
    exit 1
fi

openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -sha256 -days 9000 -subj "/C=NL/ST=Noord-Holland/L=Amsterdam/O=jor.dev/OU=IT/CN=$1" -addext "subjectAltName = DNS:localhost"
