#!/bin/sh

usage() {
    cat <<'EOF'
Usage: create_csr <key.pem> <common-name>

Creates a certificate signing request, cert.csr, in the current folder
from an existing key. <common-name> becomes the CN of the request.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        echo "Unknown option '$1', see 'create_csr --help'" >&2
        exit 1
        ;;
esac

if [ $# -lt 2 ]; then
    echo "Expected a key file and a common name, see 'create_csr --help'" >&2
    exit 1
fi

lib=$(dirname "$0")/lib
"$lib/require_command" openssl || exit 1
"$lib/require_file" "$1" || exit 1

openssl req -new -sha256 -key "$1" -subj "/C=NL/ST=Noord-Holland/L=Amsterdam/O=jor.dev/OU=jor.dev/CN=$2" -out cert.csr
