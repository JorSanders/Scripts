#!/bin/sh

usage() {
    cat <<'EOF'
Usage: create_keystore_jks <source.pkcs12> <target.jks>

Converts a PKCS12 keystore into a JKS keystore. keytool asks for the
passwords of both keystores.
EOF
}

if [ $# -lt 2 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    exit 0
fi

keytool -importkeystore -srckeystore "$1" -srcstoretype pkcs12 -destkeystore "$2" -deststoretype jks
