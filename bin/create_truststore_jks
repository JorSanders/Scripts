#!/bin/sh

usage() {
    cat <<'EOF'
Usage: create_truststore_jks <cert.pem> <alias> <truststore.jks>

Adds a certificate to a JKS truststore under <alias>, creating the
truststore when it does not exist yet. keytool asks for its password.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        echo "Unknown option '$1', see 'create_truststore_jks --help'" >&2
        exit 1
        ;;
esac

if [ $# -lt 3 ]; then
    echo "Expected a certificate, an alias and a truststore, see 'create_truststore_jks --help'" >&2
    exit 1
fi

lib=$(dirname "$0")/lib
"$lib/require_command" keytool || exit 1
"$lib/require_file" "$1" || exit 1

keytool -import -file "$1" -alias "$2" -keystore "$3"
