#!/bin/sh

usage() {
    cat <<'EOF'
Usage: create_csr_cert <request.csr> <ca-cert.pem> <ca-key.pem>

Signs a certificate signing request with a certificate authority and
writes the signed certificate to valid_cert.pem in the current folder.

The certificate is valid for 9000 days.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        echo "Unknown option '$1', see 'create_csr_cert --help'" >&2
        exit 1
        ;;
esac

if [ $# -lt 3 ]; then
    echo "Expected a request, a CA certificate and a CA key, see 'create_csr_cert --help'" >&2
    exit 1
fi

lib=$(dirname "$0")/lib
"$lib/require_command" openssl || exit 1
"$lib/require_file" "$1" "$2" "$3" || exit 1

openssl x509 -req -in "$1" -CA "$2" -CAkey "$3" -CAcreateserial -out valid_cert.pem -days 9000 -sha256
