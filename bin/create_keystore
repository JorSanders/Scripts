#!/bin/sh

usage() {
    cat <<'EOF'
Usage: create_keystore <file.pem>

Creates a PKCS12 keystore, keystore.pkcs12, in the current folder from a
PEM file holding a certificate and its key. openssl asks for the export
password.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
esac

if [ $# -lt 1 ]; then
    echo "Expected a PEM file, see 'create_keystore --help'" >&2
    exit 1
fi

openssl pkcs12 -export -in "$1" -out keystore.pkcs12
