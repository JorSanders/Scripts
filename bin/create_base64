#!/bin/sh

usage() {
    cat <<'EOF'
Usage: create_base64 <file>

Writes a base64 encoded copy of <file> next to it, as <file>.base64.txt.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        echo "Unknown option '$1', see 'create_base64 --help'" >&2
        exit 1
        ;;
esac

if [ $# -lt 1 ]; then
    echo "Expected a file to encode, see 'create_base64 --help'" >&2
    exit 1
fi

lib=$(dirname "$0")/lib
"$lib/require_command" openssl || exit 1
"$lib/require_file" "$1" || exit 1

openssl base64 -in "$1" -out "$1".base64.txt
