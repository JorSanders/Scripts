#!/bin/sh

usage() {
    cat <<'EOF'
Usage: wip

Stages every change in the repository and commits them under a 'WIP'
message.
EOF
}

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        echo "Unknown option '$1', see 'wip --help'" >&2
        exit 1
        ;;
esac

if [ $# -gt 0 ]; then
    echo "Expected no arguments, see 'wip --help'" >&2
    exit 1
fi

git add . && git commit -m 'WIP'
